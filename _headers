# Tipo certo pros manifests (o Netlify servia como application/octet-stream)
/clube.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8

# Painel do Clube (03/11/2026): area interna - fora do Google, sem iframe, sem cache
/painel-clube
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: no-referrer
  Cache-Control: no-store
/painel-clube.html
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: no-referrer
  Cache-Control: no-store
